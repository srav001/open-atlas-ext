{
	"name": "open-atlas-ext",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "pnpm run dev:extension",
		"dev:extension": "vite build --watch --mode development",
		"dev:ui": "vite",
		"build": "vite build",
		"build:artifact": "pnpm build && node scripts/package-extension.mjs",
		"test:extension": "pnpm build && node scripts/verify-extension.mjs",
		"test": "pnpm run test:extension",
		"check": "tsc --noEmit",
		"preview": "vite preview",
		"format": "prettier . --write ."
	},
	"dependencies": {
		"solid-js": "^1.9.9"
	},
	"devDependencies": {
		"@types/chrome": "^0.1.27",
		"@types/node": "^24.6.0",
		"prettier": "^3.6.2",
		"prettier-plugin-organize-imports": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.7.0",
		"typescript": "~5.9.3",
		"vite": "npm:rolldown-vite@latest",
		"vite-plugin-solid": "^2.11.8"
	},
	"pnpm": {
		"overrides": {
			"vite": "npm:rolldown-vite@latest"
		}
	}
}
