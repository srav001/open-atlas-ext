{
	"manifest_version": 3,
	"name": "Open Atlas Assistant",
	"description": "Developer sandbox for the Open Atlas AI browsing assistant Chrome extension.",
	"version": "0.1.0",
	"action": {
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png"
		},
		"default_title": "Open Atlas Assistant"
	},
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"permissions": ["sidePanel", "storage", "activeTab", "scripting"],
	"host_permissions": ["https://*/*", "http://*/*"],
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"side_panel": {
		"default_path": "sidepanel.html"
	},
	"content_scripts": [
		{
			"matches": ["https://*/*", "http://*/*"],
			"js": ["content.js"],
			"run_at": "document_idle"
		}
	],
	"web_accessible_resources": [
		{
			"resources": ["assets/*"],
			"matches": ["https://*/*", "http://*/*"]
		}
	]
}
